# TechParts AI — variáveis de ambiente
# Copie para `.env` na raiz do repositório (nunca commitar o `.env` real).
# Fonte canônica alinhada a `backend/config/settings/base.py` (+ local/staging/production).

# =============================================================================
# Django
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=dev-only-change-me-techparts-f2
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Database / cache / filas
# =============================================================================
# Local default = SQLite (settings). Compose sobrescreve com Postgres.
# DATABASE_URL=postgres://techparts:techparts@127.0.0.1:5432/techparts
# Réplica opcional (T-P.5) — ativa PrimaryReplicaRouter quando setada:
# DATABASE_READ_REPLICA_URL=postgres://techparts:techparts@127.0.0.1:5433/techparts

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true

# =============================================================================
# Segurança
# =============================================================================
AXES_ENABLED=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Sessão autenticada: 24h, renova a cada request, não cai ao fechar o browser
SESSION_COOKIE_AGE=86400
SESSION_SAVE_EVERY_REQUEST=true
SESSION_EXPIRE_AT_BROWSER_CLOSE=false

# =============================================================================
# Observabilidade
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# SENTRY_UI_URL=https://sentry.io/...
FLOWER_URL=http://localhost:5555
# GRAFANA_URL=http://localhost:3000
# SLACK_WEBHOOK_URL=
OPS_ALERT_EMAILS=ops@techparts.local

# =============================================================================
# Manuais / fotos / storage (F3 + F6) — Cloudflare R2
# Cobre manuais (`manuals/...`) e fotos (`photos/{uuid}/...`) via STORAGES.default
# =============================================================================
USE_R2_STORAGE=false
# USE_R2_STORAGE=true
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# (somente o host — sem /bucket no path)
# R2_REGION_NAME=auto
MANUAL_MAX_UPLOAD_BYTES=26214400
MANUAL_SIGNED_URL_EXPIRES=3600
MANUAL_OCR_ENABLED=true
# Idiomas Tesseract (precisa tesseract-ocr + tesseract-ocr-por no SO)
MANUAL_OCR_LANGS=por+eng
MANUAL_OCR_MAX_PAGES=40
MANUAL_OCR_SCALE=2.5
MANUAL_AV_STUB_OK=true
# ClamAV (Compose: docker compose --profile clamav up -d)
# No runserver local: MANUAL_CLAMAV_ENABLED=false (hostname "clamav" só resolve na rede Compose).
# Com profile publicado na porta do host: CLAMAV_HOST=127.0.0.1
# Não use comentário inline na mesma linha do valor (quebra o parse do host).
MANUAL_CLAMAV_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

EXTRACTION_LLM_MODE=mock
# EXTRACTION_LLM_MODE=openai
# LangSmith — https://smith.langchain.com → Settings → API Keys
# Projetos separados por ambiente (docs/pilares/14-cicd.md):
#   local: techparts-ai-local · staging: techparts-ai-staging · prod: techparts-ai
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=techparts-ai-local

CART_RESERVATION_MINUTES=30
CATALOG_CACHE_TTL=60

# =============================================================================
# IA: chat RAG / embeddings / diagnóstico / foto (F5–F6) — só OpenAI
# =============================================================================
AI_RATE_LIMIT=30/m
AI_TOKEN_BUDGET_DAILY=0
AI_TOKEN_BUDGET_PER_REQUEST=0
AI_COST_ALERT_USD=5.0
AI_LATENCY_ALERT_MS=8000

CHAT_LLM_MODE=mock
# CHAT_LLM_MODE=openai
EMBEDDING_MODE=mock
# EMBEDDING_MODE=openai
# OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=64
USE_PGVECTOR=true
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
# Só exibe resposta do agente com acertividade ≥ este valor (0–1); abaixo disso abre chamado
CHAT_MIN_ANSWER_CONFIDENCE=0.70

PHOTO_LLM_MODE=mock
# PHOTO_LLM_MODE=openai
PHOTO_MAX_UPLOAD_BYTES=5242880
# Busca de fotos no cadastro: mock (CI/local) ou ddgs (DuckDuckGo Images)
WEB_IMAGE_SEARCH_MODE=mock
# WEB_IMAGE_SEARCH_MODE=ddgs
DIAGNOSIS_LLM_MODE=mock
# DIAGNOSIS_LLM_MODE=openai
GOLDEN_MIN_SCORE=0.66
RAG_GOLDEN_MIN_SCORE=0.66

# =============================================================================
# Checkout / frete / NF-e / e-mail (F4b + T-P.4)
# =============================================================================
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# URL pública do site (back_urls / notification_url do Checkout Pro)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_CHECKOUT_MODE=preference
# MERCADOPAGO_CHECKOUT_MODE=token
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_STUB=false
# MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# MELHOR_ENVIO_FROM_CEP=01310100
SHIPPING_FIXED_PRICE=19.90
SHIPPING_FREE_FROM=299.00

NFE_PROVIDER=mock
# NFE_PROVIDER=notaas
# API_KEY_NOTAAS=ntaas_...
# NOTAAS_BASE_URL=https://platform.notaas.com.br/api/v1
# NFE_DEFAULT_NCM=85437099
# NFE_DEFAULT_IBGE_CODE=3550308
# NFE_DEFAULT_DEST_DOCUMENT=00000000000
# NFE_DEFAULT_CSOSN=102
# NFE_PROVIDER=focusnfe
# FOCUSNFE_TOKEN=
# FOCUSNFE_BASE_URL=https://homologacao.focusnfe.com.br
# NFE_EMITTER_CNPJ=
# NFE_DEFAULT_CFOP=5102

DEFAULT_FROM_EMAIL=noreply@techparts.local
RETURN_CDC_DAYS=7
TICKET_SLA_HOURS=24

# =============================================================================
# Assinaturas / WhatsApp / PWA (F8 + T-P.4)
# =============================================================================
SUBSCRIPTION_BILLING_MODE=mock
# SUBSCRIPTION_BILLING_MODE=stripe
# SUBSCRIPTION_BILLING_MODE=mercadopago

WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=techparts-dev
WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_MODE=live

PWA_ENABLED=false

# =============================================================================
# Staging / produção (ver docs/deploy.md)
# =============================================================================
# DJANGO_SETTINGS_MODULE=config.settings.staging
# SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">
# ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,staging.local
# CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:8081,http://127.0.0.1:8081
# DEBUG=false
# AXES_ENABLED=true
# AI_TOKEN_BUDGET_DAILY=500000
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=false
# SENTRY_ENVIRONMENT=staging
# CHAT_LLM_MODE=openai
# EMBEDDING_MODE=openai
# DIAGNOSIS_LLM_MODE=openai
# PHOTO_LLM_MODE=openai
# EXTRACTION_LLM_MODE=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_DIMS=1536
#
# Portas publicadas no host (Compose). Locais usam defaults do docker-compose.yml
# (8000/8080/5555/6379). Staging (docker-compose.staging.yml) usa:
# WEB_PUBLISH_PORT=8001
# NGINX_PUBLISH_PORT=8081
# FLOWER_PUBLISH_PORT=5556
# REDIS_PUBLISH_PORT=6380
# CLAMAV_PUBLISH_PORT=3310
# FLOWER_URL=http://localhost:5556
# Se mudar as portas, alinhe CSRF_TRUSTED_ORIGINS.
