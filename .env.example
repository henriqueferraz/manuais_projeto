# TechParts AI — variáveis de ambiente (nunca commitar .env real)

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=dev-only-change-me-techparts-f2
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (local default = SQLite via settings; Compose sobrescreve)
# DATABASE_URL=postgres://techparts:techparts@127.0.0.1:5432/techparts

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true

# Segurança / Axes
AXES_ENABLED=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Observabilidade (opcional em local)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Rate limit stub IA
AI_RATE_LIMIT=30/m

# --- Fase 3: manuais / extração ---
USE_R2_STORAGE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
MANUAL_MAX_UPLOAD_BYTES=26214400
MANUAL_SIGNED_URL_EXPIRES=3600
MANUAL_CLAMAV_ENABLED=false
MANUAL_AV_STUB_OK=true
MANUAL_OCR_ENABLED=false
EXTRACTION_LLM_MODE=mock
# EXTRACTION_LLM_MODE=anthropic
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=techparts-ai
CART_RESERVATION_MINUTES=30
CATALOG_CACHE_TTL=60

# --- Fase 5: chat RAG ---
CHAT_LLM_MODE=mock
# CHAT_LLM_MODE=anthropic
EMBEDDING_MODE=mock
# EMBEDDING_MODE=openai
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=64
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
USE_PGVECTOR=true
AI_COST_ALERT_USD=5.0
AI_LATENCY_ALERT_MS=8000

# --- Fase 6: diagnóstico / foto / golden CI ---
PHOTO_LLM_MODE=mock
# PHOTO_LLM_MODE=anthropic
PHOTO_MAX_UPLOAD_BYTES=5242880
DIAGNOSIS_LLM_MODE=mock
GOLDEN_MIN_SCORE=0.66
RAG_GOLDEN_MIN_SCORE=0.66

# --- Fase 4b: checkout / pagamento / frete / NF-e ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
MELHOR_ENVIO_ENABLED=false
# MELHOR_ENVIO_TOKEN=
SHIPPING_FIXED_PRICE=19.90
SHIPPING_FREE_FROM=299.00
NFE_PROVIDER=mock
DEFAULT_FROM_EMAIL=noreply@techparts.local
RETURN_CDC_DAYS=7
