        "headerParameters": {
          "parameters": [
            {
              "name": "X-Lowcode-Secret",
              "value": "={{ $env.LOWCODE_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'n8n', title: 'Alerta ops (n8n)', message: 'Falhas 24h: ' + $json.failures_24h + ' | filas: ' + JSON.stringify($json.queues), failures_24h: $json.failures_24h, queues: $json.queues, severity: 'warning' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
